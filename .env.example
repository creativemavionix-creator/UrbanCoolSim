# ==============================================================================
# UrbanCoolSim Environment Configuration Template
# ==============================================================================
# Copy this template to .env before starting the platform:
# cp .env.example .env
#
# IMPORTANT: Never commit the active .env file containing real secrets to version control.
# ==============================================================================

# Security & JWT Authentication (REQUIRED: must be set, minimum 16 chars)
# The application will refuse to start if SECRET_KEY is unset or set to the old placeholder!
SECRET_KEY=change_this_to_a_secure_random_production_jwt_secret_key_32_bytes

# Database Configuration
# (Note: Docker Compose automatically wires the backend to @postgres:5432 using POSTGRES_USER/PASSWORD/DB)
# For local bare-metal runs outside Docker, point to localhost:
POSTGRES_USER=urbancoolsim
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_DB=urbancoolsim
DATABASE_URL=postgresql+asyncpg://urbancoolsim:change_this_postgres_password_in_production@localhost:5432/urbancoolsim
SYNC_DATABASE_URL=postgresql://urbancoolsim:change_this_postgres_password_in_production@localhost:5432/urbancoolsim
# Alternatively, for zero-config SQLite local development without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./urbancoolsim.db
# SYNC_DATABASE_URL=sqlite:///./urbancoolsim.db

# Platform Runtime Environment
ENVIRONMENT=development
DEBUG=True

# Resource & Rate Constraints
MAX_SIMULATION_CELLS=1000000
MAX_OPTIMIZATION_ITERATIONS=200
MAX_POPULATION_SIZE=100
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_SIMULATIONS=4

# Network, CORS & Frontend API Wiring
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
